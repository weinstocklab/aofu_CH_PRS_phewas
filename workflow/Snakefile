        """


rule score_chromosome:
    input:
        pgen=lambda wildcards: genotype_file(wildcards, "pgen"),
        pvar=lambda wildcards: genotype_file(wildcards, "pvar"),
        psam=lambda wildcards: genotype_file(wildcards, "psam"),
        weights="resources/weights/chr{chrom}.score.tsv",
        keep=cfg_path("keep_file"),
    output:
        sscore=f"{SCORE_DIR}/chr{{chrom}}/{SCORE_NAME}.chr{{chrom}}.sscore",
        vars=f"{SCORE_DIR}/chr{{chrom}}/{SCORE_NAME}.chr{{chrom}}.sscore.vars",
    params:
        out_prefix=lambda wildcards: f"{SCORE_DIR}/chr{wildcards.chrom}/{SCORE_NAME}.chr{wildcards.chrom}",
        pfile=genotype_pfile_prefix,
        plink2=lambda wildcards: cfg_path("plink2"),
        biallelic_flag=lambda wildcards: "--max-alleles 2" if config.get("biallelic_only", True) else "",
    threads:
        int(config.get("threads_per_chromosome", 1))
    log:
        "logs/score_chr{chrom}.log"
    shell:
        """
        mkdir -p {SCORE_DIR}/chr{wildcards.chrom}
        {params.plink2} \
          --pfile {params.pfile} \
          --keep {input.keep} \
          {params.biallelic_flag} \
          --set-all-var-ids 'chr@:#:$r:$a' \
          --new-id-max-allele-len 2000 \
          --score {input.weights} 1 2 3 no-mean-imputation list-variants cols=maybefid,nallele,denom,dosagesum,scoresums \
          --threads {threads} \
          --out {params.out_prefix} \
          > {log} 2>&1
        """


rule combine_chromosome_scores:
    input:
        expand(f"{SCORE_DIR}/chr{{chrom}}/{SCORE_NAME}.chr{{chrom}}.sscore", chrom=CHROMS)
    output:
        cfg_path("final_score")
    log:
        "logs/combine_scores.log"
    shell:
        """
        python workflow/scripts/combine_scores.py \
          --score-name {SCORE_NAME} \
          --out {output} \
          {input} \
          > {log} 2>&1
        """


