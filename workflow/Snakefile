configfile: "config/config.yaml"

import os


CHROMS = [str(chrom) for chrom in config["chromosomes"]]
SCORE_DIR = config["score_dir"]
SCORE_NAME = config["score_name"]
PHEWAS_CONFIG = config["phewas"]


def cfg_path(key):
    value = config[key]
    if isinstance(value, str):
        return os.path.expandvars(value)
    return value


def genotype_source_prefix(wildcards):
    return config["genotype_prefix_template"].format(chrom=wildcards.chrom)


def genotype_pfile_prefix(wildcards):
    source_prefix = genotype_source_prefix(wildcards)
    return os.path.join(os.path.expandvars(config["genotype_mount_prefix"]), source_prefix)


def genotype_file(wildcards, suffix):
    return f"{genotype_pfile_prefix(wildcards)}.{suffix}"


rule all:
    input:
        cfg_path("final_score"),
        os.path.expandvars(PHEWAS_CONFIG["output"]),
        os.path.expandvars(PHEWAS_CONFIG["spline_output"]),
        os.path.expandvars(PHEWAS_CONFIG["survival_output"]),
        os.path.expandvars(PHEWAS_CONFIG["landmark_survival_output"]),
        os.path.expandvars(PHEWAS_CONFIG["tail_output"]),
        os.path.expandvars(PHEWAS_CONFIG["age_interaction_output"]),
        os.path.expandvars(PHEWAS_CONFIG["supplementary_logistic_covariate_output"]),
        os.path.expandvars(PHEWAS_CONFIG["supplementary_min_code_count2_output"]),
        os.path.expandvars(PHEWAS_CONFIG["supplementary_survival_sensitivity_output"]),
        os.path.expandvars(PHEWAS_CONFIG["supplementary_decile_risk_output"]),
        os.path.expandvars(PHEWAS_CONFIG["second_wave_ehr_utilization_output"]),
        os.path.expandvars(PHEWAS_CONFIG["second_wave_sex_stratified_output"]),
        os.path.expandvars(PHEWAS_CONFIG["second_wave_prs_outlier_output"]),
        os.path.expandvars(PHEWAS_CONFIG["second_wave_decile_ci_output"]),
        os.path.expandvars(PHEWAS_CONFIG["second_wave_prior_cancer_output"]),
        os.path.expandvars(PHEWAS_CONFIG["somatic_burden_logistic_output"]),
        os.path.expandvars(PHEWAS_CONFIG["somatic_burden_post_draw_survival_output"]),
        expand(f"{SCORE_DIR}/chr{{chrom}}/{SCORE_NAME}.chr{{chrom}}.sscore.vars", chrom=CHROMS),


rule split_weights_by_chr:
    input:
        cfg_path("weights")
    output:
        expand("resources/weights/chr{chrom}.score.tsv", chrom=CHROMS)
    log:
        "logs/split_weights.log"
    params:
        chromosomes=" ".join(CHROMS)
    shell:
        """
        python workflow/scripts/split_weights_by_chr.py \
          --weights {input} \
          --out-dir resources/weights \
          --chromosomes {params.chromosomes} \
          > {log} 2>&1
        """


