        survival=os.path.expandvars(PHEWAS_CONFIG["somatic_burden_post_draw_survival_output"]),
    params:
        exposure_col=PHEWAS_CONFIG.get("somatic_burden_col", "V3"),
        min_code_count=PHEWAS_CONFIG.get("min_code_count", 1),
        age_cols=",".join(PHEWAS_CONFIG["age_cols"]),
        pc_cols=",".join(PHEWAS_CONFIG["pc_cols"]),
    log:
        "logs/somatic_burden_phewas.log"
    shell:
        """
        python workflow/scripts/run_somatic_burden_phewas.py \
          --exposure {input.exposure} \
          --exposure-col {params.exposure_col} \
          --phenotypes {input.phenotypes} \
          --phenotype-summary {input.summary} \
          --covariates {input.covariates} \
          --target-map {input.target_map} \
          --evidence {input.evidence} \
          --survival-base {input.survival_base} \
          --age-at-sequencing {input.age_at_sequencing} \
          --min-code-count {params.min_code_count} \
          --age-cols {params.age_cols} \
          --pc-cols {params.pc_cols} \
          --logistic-out {output.logistic} \
          --survival-out {output.survival} \
          > {log} 2>&1
        """
