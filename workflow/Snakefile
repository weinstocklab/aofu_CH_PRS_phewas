rule build_phewas_phenotypes:
    input:
        targets=os.path.expandvars(PHEWAS_CONFIG["targets"]),
        target_map=os.path.expandvars(PHEWAS_CONFIG["target_icd_map"]),
        evidence=os.path.expandvars(PHEWAS_CONFIG["icd_evidence"]),
        denominator=os.path.expandvars(PHEWAS_CONFIG["ehr_denominator"]),
        scores=cfg_path("final_score"),
        covariates=cfg_path("covariates"),
    output:
        phenotypes=os.path.expandvars(PHEWAS_CONFIG["phenotypes"]),
        summary=os.path.expandvars(PHEWAS_CONFIG["phenotype_summary"]),
    params:
        min_code_count=PHEWAS_CONFIG.get("min_code_count", 2),
        force_include_flag="--force-include-all" if PHEWAS_CONFIG.get("force_include_all_targets", False) else "",
    log:
        "logs/build_phewas_phenotypes.log"
    shell:
        """
        python workflow/scripts/build_phewas_phenotypes.py \
          --targets {input.targets} \
          --target-map {input.target_map} \
          --evidence {input.evidence} \
          --denominator {input.denominator} \
          --scores {input.scores} \
          --covariates {input.covariates} \
          --min-code-count {params.min_code_count} \
          {params.force_include_flag} \
          --phenotypes-out {output.phenotypes} \
          --summary-out {output.summary} \
          > {log} 2>&1
        """


rule phewas:
    input:
        score=cfg_path("final_score"),
        phenotypes=os.path.expandvars(PHEWAS_CONFIG["phenotypes"]),
        summary=os.path.expandvars(PHEWAS_CONFIG["phenotype_summary"]),
        covariates=cfg_path("covariates"),
    output:
        os.path.expandvars(PHEWAS_CONFIG["output"])
    params:
        prs_col=PHEWAS_CONFIG.get("prs_col", "PRSFNN_out_final_Z"),
        age_cols=",".join(PHEWAS_CONFIG["age_cols"]),
        pc_cols=",".join(PHEWAS_CONFIG["pc_cols"]),
    log:
        "logs/phewas.log"
    shell:
        """
        python workflow/scripts/run_targeted_phewas.py \
          --scores {input.score} \
          --phenotypes {input.phenotypes} \
          --phenotype-summary {input.summary} \
          --covariates {input.covariates} \
          --prs-col {params.prs_col} \
          --age-cols {params.age_cols} \
          --pc-cols {params.pc_cols} \
          --out {output} \
          > {log} 2>&1
        """


